{
  "name": "agent-action-gateway",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents take real business actions safely",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsc && npx @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "migrate:status": "tsx src/scripts/migrate.ts status",
    "migrate:apply": "tsx src/scripts/migrate.ts apply",
    "app-password:status": "tsx src/scripts/set-app-password.ts status",
    "app-password:rotate": "tsx src/scripts/set-app-password.ts rotate"
  },
  "author": "Ali Nejad",
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.13.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}