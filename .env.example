# Copy this file to .env and fill in real values. Never commit .env.

# WooCommerce REST API (WooCommerce > Settings > Advanced > REST API)
WOO_BASE_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HTTP transport (only needed when running the HTTP server, e.g. for n8n)
# Generate a token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_HTTP_TOKEN=
MCP_HTTP_PORT=3333
MCP_HTTP_HOST=127.0.0.1