# Copy this file to .env and fill in real values. Never commit .env.

# WooCommerce REST API (WooCommerce > Settings > Advanced > REST API)
WOO_BASE_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HTTP transport (only needed when running the HTTP server, e.g. for n8n)
# Generate a token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_HTTP_TOKEN=
MCP_HTTP_PORT=3333
MCP_HTTP_HOST=127.0.0.1

# Database: Supabase Postgres (audit log, idempotency)
# Supabase dashboard > Connect > Direct > Session pooler (IPv4).
# On an IPv6 network you can use the direct host instead: db.<project-ref>.supabase.co
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# The server connects as the restricted role gateway_app, never as postgres.
# Do not type these two values: "npm run app-password:rotate" generates the password
# and writes both lines for you. Keep exactly one DB_USER line and one DB_PASSWORD line.
DB_USER=gateway_app.<project-ref>
DB_PASSWORD=written-by-app-password-rotate
# CA certificate: Database > Settings > SSL Configuration > Download certificate.
# Save it in certs/ (gitignored). Connections use full certificate verification.
DB_CA_CERT=certs/prod-ca-2021.crt

# Admin credentials do NOT belong in this file. Create a second file named .env.admin
# (gitignored, never loaded by the server) with these two lines:
#   DB_ADMIN_USER=postgres.<project-ref>
#   DB_ADMIN_PASSWORD=<your Supabase database password>
# It is only read by the admin scripts: migrate:*, app-password:*. See docs/database.md.